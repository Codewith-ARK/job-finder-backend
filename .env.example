# Database. Postgres is the deployment target; SQLite keeps local runs effortless.
DATABASE_URL=sqlite:///./data/jobfinder.db
# Production Compose requires a unique password; generated with: openssl rand -hex 24
# POSTGRES_PASSWORD=replace-with-a-long-random-value

# development | test | production. Production refuses demo data, demo login,
# Swagger testing, insecure cookies, non-HTTPS origins, and default DB credentials.
APP_ENVIRONMENT=development

# Browser origins allowed to talk to the API directly (the Next.js proxy is same-origin).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Comma-separated Host header allowlist. Empty disables host filtering locally;
# production should list the public host name(s) that reach the API.
TRUSTED_HOSTS=

# HSTS max-age in seconds. 0 sends no header; enable after HTTPS is verified.
HSTS_SECONDS=0

# Trusted proxy hops for X-Forwarded-For. Point this at the Next.js server or the
# edge network, never '*', and keep port 8000 unreachable from the internet.
FORWARDED_ALLOW_IPS=127.0.0.1

# Local API testing through Swagger UI at /docs. When true, the API accepts its
# own origin and Swagger echoes the CSRF cookie on state-changing requests.
# Keep false outside local development.
DOCS_TESTING_ENABLED=false

# Session cookies. Set COOKIE_SECURE=true behind HTTPS.
COOKIE_SECURE=false
SESSION_DAYS=7
# Expired/revoked sessions older than this are deleted on startup.
SESSION_RETENTION_DAYS=7

# Demo accounts and startup seeding.
DEMO_LOGIN_ENABLED=true
SEED_ON_STARTUP=true

# Private document storage (never inside public/static directories).
DOCUMENT_DIR=storage/documents
MAX_UPLOAD_BYTES=10485760
MAX_DOCUMENTS_PER_CANDIDATE=10
MAX_CANDIDATE_DOCUMENT_BYTES=52428800

# Process-local limits. One API replica is assumed; a second replica needs
# shared/gateway enforcement for the same limits to hold.
REQUESTS_PER_MINUTE=120
AUTH_REQUESTS_PER_MINUTE=20
REGISTER_REQUESTS_PER_MINUTE=5
LOGIN_MAX_FAILURES=8
LOGIN_LOCKOUT_SECONDS=900
MAX_JSON_BYTES=262144
MAX_BODY_READERS=8
BODY_TIMEOUT_SECONDS=15

# Upper bound on rows returned by a workspace response (no pagination contract yet).
MAX_WORKSPACE_ITEMS=500
