# Database. Postgres is the deployment target; SQLite keeps local runs effortless.
DATABASE_URL=sqlite:///./data/jobfinder.db

# Browser origins allowed to talk to the API directly (the Next.js proxy is same-origin).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Session cookies. Set COOKIE_SECURE=true behind HTTPS.
COOKIE_SECURE=false
SESSION_DAYS=7

# Demo accounts and startup seeding.
DEMO_LOGIN_ENABLED=true
SEED_ON_STARTUP=true

# Private document storage (never inside public/static directories).
DOCUMENT_DIR=storage/documents
